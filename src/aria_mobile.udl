namespace aria_mobile {
    /// Initialize the Rust runtime. Must be called once at app startup.
    void init_runtime();

    /// Shut down the Rust runtime. Call on app termination.
    void shutdown_runtime();

    /// A fresh `outgoing-<uuid>` call_id for `make_call_with_id`.
    string new_outgoing_call_id();
};

/// Configuration for connecting to the push gateway.
dictionary GatewayConfig {
    string base_url;
    /// The PBX-issued gateway token (`gateway_token` from the PBX device
    /// registration), used as the bearer token for every gateway request.
    /// The core never mints tokens itself. Replace it later with
    /// `set_gateway_token`.
    string api_key;
};

/// SIP account credentials for device registration.
dictionary SipCredentials {
    string username;
    string password;
    string domain;
    string? registrar;
    string transport;
    u16 port;
    string? auth_username;
    string display_name;
};

/// Device registration request.
dictionary DeviceRegistration {
    string platform;
    string push_token;
    string? bundle_id;
    SipCredentials sip;
};

/// Response from device registration.
dictionary DeviceRegistrationResponse {
    string device_id;
    string auth_token;
};

/// Incoming call offer from the gateway.
dictionary CallOffer {
    string call_token;
    string caller_uri;
    string? caller_name;
    string sdp_offer;
};

/// Current call state.
enum CallState {
    "Idle",
    "Incoming",
    "Ringing",
    "Connecting",
    "Connected",
    "OnHold",
    "Ended",
};

/// Call direction.
enum CallDirection {
    "Inbound",
    "Outbound",
};

/// Information about an active call.
dictionary CallInfo {
    string call_id;
    string remote_uri;
    string? remote_name;
    CallState state;
    CallDirection direction;
    boolean muted;
    boolean on_hold;
    u64 duration_secs;
};

/// Audio codec selection.
enum AudioCodec {
    "Pcmu",
    "Pcma",
    "Opus",
    "G729",
};

/// RTP media statistics.
dictionary MediaStats {
    u64 packets_sent;
    u64 packets_received;
    u64 bytes_sent;
    u64 bytes_received;
    f64 jitter_ms;
    u32 packet_loss;
    f64 rtt_ms;
};

/// Push notification payload (parsed from APNs/FCM data).
dictionary PushCallPayload {
    string call_token;
    string caller_uri;
    string? caller_name;
    string gateway_url;
};

/// Callback interface for platform audio I/O (microphone + speaker).
/// Implemented by the Android (Oboe/AudioTrack) or iOS (AudioUnit) layer.
callback interface PlatformAudioBridge {
    /// Called when decoded PCM audio is ready for playback (speaker).
    /// Samples are mono i16 at the given sample rate.
    void on_playback_audio(sequence<i16> samples, u32 sample_rate);

    /// Called to request microphone audio for sending.
    /// Should return mono i16 PCM at the given sample rate, frame_size samples.
    sequence<i16> on_capture_audio(u32 sample_rate, u32 frame_size);
};

/// Callback interface for receiving events from the Rust core.
///
/// Callbacks are delivered one at a time on a dedicated core thread, never
/// inside the core's runtime, and asynchronously with respect to the engine
/// method that caused them. They may call any engine method, including the
/// blocking ones, but should not block for long themselves. See the
/// "Event contract" section of the README for the guaranteed sequence.
callback interface MobileEventHandler {
    /// Called when registration state changes.
    void on_registration_changed(string device_id, string status, string? error);

    /// Called when an incoming call arrives (via push notification).
    void on_incoming_call(CallOffer offer);

    /// Called when call state changes. Every call_id that has been reported
    /// gets exactly one final `Ended`, whoever ended the call (local hangup,
    /// remote hangup, transfer, caller cancel, or a failed outgoing call).
    void on_call_state_changed(CallInfo info);

    /// Called when media statistics are updated.
    void on_media_stats(string call_id, MediaStats stats);

    /// Called when background work failed in a way the app should surface.
    /// Currently fired with context `"hangup"` when the gateway did not
    /// confirm hanging up a call even after one retry (for example a 404
    /// because it does not know the call): the call has ended here, but the
    /// other party may still be connected. `message` names the call_id.
    void on_error(string context, string message);

    /// Called when background work (call-status polls, the caller-cancel
    /// watch, the network-change heartbeat, `hangup`'s gateway hangup or
    /// cancel, and hanging up an outgoing call that was answered after it
    /// was cancelled) had the gateway token rejected with 401. Fetch a new token from
    /// the PBX (`POST /api/v1/devices/{id}/gateway-token`) and pass it to
    /// `set_gateway_token`. Emitted at most once per token: it fires again
    /// only after `set_gateway_token` has been called and the new token is
    /// rejected too. A rejected poll does not end the call; polling resumes
    /// with the new token. Engine methods report a 401 by throwing
    /// `AuthenticationError` instead of through this callback.
    void on_auth_required();
};

/// The main mobile SIP engine interface.
interface AriaMobileEngine {
    /// Create a new engine with the given gateway configuration.
    constructor(GatewayConfig gateway_config);

    /// Set the event handler for receiving callbacks.
    void set_event_handler(MobileEventHandler handler);

    /// Set the platform audio bridge for microphone/speaker I/O.
    void set_audio_bridge(PlatformAudioBridge bridge);

    /// Replace the bearer token used for all gateway requests, including the
    /// background call-status polls. Pass a token fetched from the PBX
    /// (`POST /api/v1/devices/{id}/gateway-token`). Does not re-register.
    void set_gateway_token(string token);

    // ── Device Registration ─────────────────────────────────────────

    /// Register this device with the push gateway, authenticating with the
    /// current PBX-issued gateway token. Returns device_id and the token used.
    [Throws=MobileError]
    DeviceRegistrationResponse register_device(DeviceRegistration registration);

    /// Unregister this device from the push gateway.
    [Throws=MobileError]
    void unregister_device(string device_id);

    /// Update the push token (e.g., after token refresh).
    [Throws=MobileError]
    void update_push_token(string device_id, string new_token);

    // ── Incoming Call Handling (via push gateway) ───────────────────

    /// Process a push notification payload and retrieve the call offer.
    [Throws=MobileError]
    CallOffer handle_push_notification(PushCallPayload payload);

    /// Accept an incoming call with local SDP answer.
    [Throws=MobileError]
    CallInfo accept_incoming_call(string call_token, sequence<AudioCodec> preferred_codecs);

    /// Reject an incoming call.
    [Throws=MobileError]
    void reject_incoming_call(string call_token);

    // ── Outgoing Calls (direct SIP) ────────────────────────────────

    /// Make an outgoing call through the gateway under `call_id`, which the
    /// app chose, normally with `new_outgoing_call_id()`: `outgoing-`
    /// followed by 1-64 characters from `[A-Za-z0-9_-]`. Blocks until the far
    /// end answers or the call fails, after reporting `Ringing`.
    ///
    /// Throws `InvalidState` for a malformed id, or one that is in use or
    /// was used recently. Because the app knows the id up front,
    /// `hangup(call_id)` works at any point:
    /// - Before this is called: `Ended` is reported at once, and this then
    ///   throws `Cancelled` without reporting anything or sending a request.
    /// - While this is blocked: `Ended` is reported and this throws
    ///   `Cancelled` at once. The core
    /// cancels the ringing call at the gateway (`POST /v1/calls/cancel` with
    /// the uuid part of the call_id as `client_ref`). If the gateway has no
    /// ringing call to cancel (answered meanwhile, or a gateway without the
    /// route) and the call is answered, the core hangs it up in the
    /// background. Any other failure reports `Ended` and throws
    /// (`AuthenticationError` on a 401).
    [Throws=MobileError]
    CallInfo make_call_with_id(string call_id, string uri, SipCredentials credentials, sequence<AudioCodec> preferred_codecs);

    /// `make_call_with_id` with an id the core picks. The app learns the id
    /// only from the `Ringing` event, which is delivered asynchronously, so
    /// it cannot reliably hang up before then. Prefer `make_call_with_id`.
    [Throws=MobileError]
    CallInfo make_call(string uri, SipCredentials credentials, sequence<AudioCodec> preferred_codecs);

    // ── Mid-call Controls ──────────────────────────────────────────

    /// Hang up a call, including an outgoing call that is still ringing or
    /// has not been made yet (see `make_call_with_id`). Throws `InvalidState`
    /// for an unknown or already ended call_id.
    ///
    /// Never waits on the gateway: the call is torn down locally and `Ended`
    /// is queued at once, and the gateway hangup (or, for a ringing call, the
    /// cancel) runs in the background. Throws `AuthenticationError`, after
    /// ending the call locally, only when there is no gateway token at all,
    /// in which case nothing is sent. Background failures are reported later:
    /// a rejected token through `on_auth_required`, and a hangup the gateway
    /// did not confirm (after one retry) through `on_error`.
    [Throws=MobileError]
    void hangup(string call_id);

    /// Blind-transfer an active call to `target` (a dial string such as
    /// "1002" or a "sip:" URI), and wait for the outcome. On success the PBX
    /// has taken the call over: the local call and its media end, and
    /// `on_call_state_changed` reports `Ended` for `call_id`.
    ///
    /// After the PBX accepts the REFER, the core polls the call's status
    /// every 300 ms until it shows the outcome, for up to 30 s.
    ///
    /// These errors leave the call fully up: `InvalidTarget` for a target
    /// rejected locally or by the gateway; `InvalidState` for an unknown call,
    /// one that is not active yet (still ringing), or a gateway without the
    /// transfer route; `CallFailed` when the PBX refused the REFER or reported
    /// the transfer failed (the message carries the SIP status, such as 486);
    /// `Timeout` when the PBX did not answer the REFER, or no outcome arrived
    /// within 30 s; `AuthenticationError` for a rejected token.
    ///
    /// `InvalidState` after the REFER was accepted means the call ended for
    /// another reason meanwhile; `Ended` has been reported. A gateway that
    /// does not report transfer outcomes ends the call on acceptance, as
    /// before. Blocks for up to about 40 s; call it off the UI thread.
    [Throws=MobileError]
    void transfer_call(string call_id, string target);

    /// Set mute state.
    [Throws=MobileError]
    void set_mute(string call_id, boolean muted);

    /// Set hold state.
    [Throws=MobileError]
    void set_hold(string call_id, boolean on_hold);

    /// Send a DTMF digit.
    [Throws=MobileError]
    void send_dtmf(string call_id, string digit);

    // ── State Queries ──────────────────────────────────────────────

    /// Get current call info, if any.
    CallInfo? get_active_call();

    /// Get media statistics for a call.
    MediaStats? get_media_stats(string call_id);

    // ── Audio ──────────────────────────────────────────────────────

    /// Get RX audio level for a call (0.0 = silence).
    f32 get_rx_audio_level(string call_id);

    /// Get TX audio level for a call (0.0 = silence).
    f32 get_tx_audio_level(string call_id);

    /// Set the preferred audio codec order.
    void set_codec_preferences(sequence<AudioCodec> codecs);

    /// Notify the core of a network connectivity change.
    /// Call this from the platform when WiFi/cellular changes, or after reconnect.
    void notify_network_change();

    // ── On-device AI ────────────────────────────────────────────────────────

    /// Was this binary built with transcription support?
    ///
    /// Lets one app package probe at runtime instead of the host guessing from
    /// its build flavour.
    /// Whether media on this call is actually encrypted.
    ///
    /// Reports what SRTP negotiation produced, not what was configured — a UI
    /// that derives a padlock from settings lies whenever the peer declines
    /// the crypto line.
    boolean call_is_encrypted(string call_id);

    boolean ai_available();

    /// Prepare on-device AI, storing models under `storage_dir`.
    ///
    /// The host owns the path — iOS Application Support, Android filesDir — so
    /// nothing here hardcodes a platform location.
    [Throws=MobileError]
    void ai_init(string storage_dir, sequence<u8>? insight_key);

    /// Models this device could install, annotated with whether it can run them.
    sequence<AiModel> ai_models();

    /// Start downloading a model. Poll `ai_download_progress` for state.
    [Throws=MobileError]
    void ai_start_download(string model_id);

    AiDownloadProgress? ai_download_progress(string model_id);

    void ai_cancel_download(string model_id);

    [Throws=MobileError]
    void ai_delete_model(string model_id);

    /// Begin capturing a call's audio for later transcription.
    ///
    /// Audio is tapped where it is decoded, so calling this does not move any
    /// samples across this boundary. Safe to call mid-call.
    [Throws=MobileError]
    void ai_start_capture(string call_id);

    /// Stop capturing without transcribing.
    void ai_stop_capture(string call_id);

    /// Transcribe what was captured, and summarise it when an LLM is installed.
    ///
    /// Runs the models, so it takes seconds to minutes depending on call length
    /// and device. Call it off the UI thread.
    [Throws=MobileError]
    AiCallInsight ai_transcribe(string call_id);

    /// Discard a captured call without transcribing it.
    void ai_discard_capture(string call_id);

    /// Past insights, newest first. Empty when transcripts are not stored.
    sequence<AiInsightSummary> ai_insights(u32 limit, u32 offset);

    /// One stored insight in full, including its transcript.
    AiCallInsight? ai_insight(string call_id);

    boolean ai_delete_insight(string call_id);

    /// Returns how many insights were deleted.
    u64 ai_clear_insights();

    /// Check if any active call was ended by the remote party.
    /// Returns the call_id if detected, null otherwise.
    ///
    /// Kept for apps that poll. The core now detects a remote hangup itself
    /// and reports it through `on_call_state_changed` (`Ended`) before the
    /// call_id appears here, so an app using the event handler does not need
    /// to call this. Only the most recent 16 IDs are retained.
    string? check_remote_hangup();
};

// ── On-device AI (feature `ai`) ──────────────────────────────────────────────
//
// Transcription runs entirely on the device: call audio is tapped inside Rust,
// where it already exists, and never crosses this boundary. The app only ever
// sees control calls and finished text.
//
// Every call below is a no-op returning an error when the core was built
// without the `ai` feature, so a host can ship one binary and probe at runtime
// with `ai_available()`.

/// One model the user can install.
dictionary AiModel {
    string id;
    /// Plain-language name for the picker. Never show a bare model id.
    string display_name;
    /// "stt" or "llm".
    string kind;
    u64 size_bytes;
    /// True when this device has the memory and class to run it.
    boolean available;
    /// Why it is unavailable, in words a user can act on.
    string? unavailable_reason;
    boolean installed;
};

/// Progress of a model download, polled rather than pushed.
dictionary AiDownloadProgress {
    string model_id;
    u64 downloaded_bytes;
    u64 total_bytes;
    /// "queued", "running", "verifying", "completed", "cancelled", "failed".
    string state;
    string? error;
};

/// One utterance in a transcript.
dictionary AiTranscriptSegment {
    /// "local" (this handset) or "remote" (the far end).
    string speaker;
    u32 start_ms;
    u32 end_ms;
    string text;
};

/// The finished result for one call.
/// A stored insight in list form, without the transcript text.
dictionary AiInsightSummary {
    string call_id;
    i64 created_at;
    u32 duration_secs;
    string status;
};

dictionary AiCallInsight {
    string call_id;
    i64 created_at;
    u32 duration_secs;
    sequence<AiTranscriptSegment> segments;
    string? language;
    /// Present only when a summarisation model is installed and ran.
    string? summary_headline;
    sequence<string> summary_points;
    /// "pending", "transcribing", "complete", "transcript_only", "failed".
    string status;
};

/// Errors that can occur in the mobile engine.
[Error]
enum MobileError {
    "NetworkError",
    /// There is no gateway token, or the gateway rejected it (HTTP 401).
    /// Every method that talks to the gateway reports a 401 this way. Fetch a
    /// new token from the PBX and pass it to `set_gateway_token`.
    "AuthenticationError",
    "RegistrationFailed",
    /// The call or a call operation failed; the message says why, for
    /// example the SIP status of a failed transfer.
    "CallFailed",
    "MediaError",
    "InvalidState",
    "GatewayError",
    "Timeout",
    /// A transfer target was empty, contained characters that are not allowed
    /// in a SIP URI header (CR, LF, '<', '>'), or was refused by the gateway.
    "InvalidTarget",
    /// `make_call` was cancelled by `hangup` before it returned. `Ended` has
    /// already been reported for the call.
    "Cancelled",
};
